# Copy to .env.local (git-ignored). Never commit real keys.
# Model: OpenCode Go gateway (OpenAI-compatible).
LLM_API_KEY=
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-flash
# PayPal sandbox app credentials (developer.paypal.com -> Apps & Credentials -> Sandbox).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
# Sandbox buyer (Personal test account) that invoices are addressed to in the demo.
SANDBOX_BUYER_EMAIL=
